#!/usr/bin/env bash
set -euo pipefail

die() {
    echo "ERROR: $*" >&2
    exit 1
}

if [[ $EUID -ne 0 ]]; then
    die "must be run as root"
fi

if [[ ! -b "{{ hdd }}" ]]; then
    die "'{{ hdd }}' is not a block device"
fi

if [[ ! -d /sys/firmware/efi/efivars ]]; then
    die "system was not booted in UEFI mode"
fi

#
# Determine partition device names.
#
# /dev/sda      -> /dev/sda1
# /dev/nvme0n1  -> /dev/nvme0n1p1
# /dev/mmcblk0  -> /dev/mmcblk0p1
#

if [[ "{{ hdd }}" =~ [0-9]$ ]]; then
    BOOT_PART="{{ hdd }}p1"
    ROOT_PART="{{ hdd }}p2"
else
    BOOT_PART="{{ hdd }}1"
    ROOT_PART="{{ hdd }}2"
fi

echo "Installing Arch Linux"
echo "Install disk:   {{ hdd }}"
echo "EFI partition:  $BOOT_PART"
echo "Root partition: $ROOT_PART"
echo

# Time
timedatectl set-ntp true

# Partition disk
echo "==> unmounting old filesystems"
umount -R /mnt 2>/dev/null || true

echo "==> clearing partition table"
sgdisk --zap-all "{{ hdd }}"

echo "==> creating partitions"
sgdisk --new=1:0:+1G "{{ hdd }}"
sgdisk --new=2:0:0 "{{ hdd }}"

echo "==> naming partitions"
sgdisk --change-name=1:boot "{{ hdd }}"
sgdisk --change-name=2:root "{{ hdd }}"

echo "==> setting partition types"
sgdisk --typecode=1:ef00 "{{ hdd }}"
sgdisk --typecode=2:8300 "{{ hdd }}"

udevadm settle

# Give the kernel a short opportunity to expose the new partition devices.
for _ in {1..20}; do
    if [[ -b "$BOOT_PART" && -b "$ROOT_PART" ]]; then
        break
    fi
    sleep 0.1
done

if [[ ! -b "$BOOT_PART" || ! -b "$ROOT_PART" ]]; then
    die "partition devices did not appear"
fi

# Filesystems
echo "==> formatting partitions"
mkfs.fat -F32 "$BOOT_PART"
mkfs.ext4 -F "$ROOT_PART"

echo "==> mounting partitions"
mount "$ROOT_PART" /mnt
mkdir -p /mnt/boot
mount "$BOOT_PART" /mnt/boot

# Packages
echo "==> determining CPU microcode package"

MICROCODE_PACKAGE=""
MICROCODE_INITRD=""
CPU_VENDOR=$(awk '/vendor_id/ { print $3; exit }' /proc/cpuinfo || true)

case "$CPU_VENDOR" in
    GenuineIntel)
        MICROCODE_PACKAGE="intel-ucode"
        MICROCODE_INITRD="/intel-ucode.img"
        ;;
    AuthenticAMD)
        MICROCODE_PACKAGE="amd-ucode"
        MICROCODE_INITRD="/amd-ucode.img"
        ;;
esac

PACKAGES=(
    base
    linux
    linux-firmware
    base-devel
    dialog
    openssh
    dhcpcd
    rsync
    zsh
    git
    python
    uv
)

if [[ -n "$MICROCODE_PACKAGE" ]]; then
    PACKAGES+=("$MICROCODE_PACKAGE")
fi

echo "==> bootstrapping base installation"
pacstrap -K /mnt "${PACKAGES[@]}"

# Filesystem table
echo "==> generating filesystem table"
genfstab -U /mnt > /mnt/etc/fstab

# Timezone
echo "==> configuring timezone"

ln -sf \
    /usr/share/zoneinfo/Europe/Berlin \
    /mnt/etc/localtime

arch-chroot /mnt hwclock --systohc

# Locale
echo "==> configuring locale"
printf '%s\n' \
    'de_DE.UTF-8 UTF-8' \
    >> /mnt/etc/locale.gen
printf '%s\n' \
    'LANG=de_DE.UTF-8' \
    > /mnt/etc/locale.conf
printf '%s\n' \
    'KEYMAP=de-latin1' \
    > /mnt/etc/vconsole.conf

arch-chroot /mnt locale-gen

# Initramfs
echo "==> generating initramfs"
arch-chroot /mnt mkinitcpio -P

# Networking
echo "==> enabling networking"
arch-chroot /mnt systemctl enable sshd
arch-chroot /mnt systemctl enable dhcpcd

# Boot loader
echo "==> installing systemd-boot"
arch-chroot /mnt bootctl install

ROOT_PARTUUID=$(blkid -s PARTUUID -o value "$ROOT_PART")

cat > /mnt/boot/loader/loader.conf <<'EOF'
default arch
timeout 2
editor 0
EOF

{
    echo "title   Arch Linux"
    echo "linux   /vmlinuz-linux"

    if [[ -n "$MICROCODE_INITRD" ]]; then
        echo "initrd  $MICROCODE_INITRD"
    fi

    echo "initrd  /initramfs-linux.img"
    echo "options root=PARTUUID=$ROOT_PARTUUID rw module_blacklist=nouveau"
} > /mnt/boot/loader/entries/arch.conf

# User
echo "==> creating user"

arch-chroot /mnt groupadd \
    --force \
    "{{ groupname }}"

arch-chroot /mnt useradd \
    --create-home \
    --gid "{{ groupname }}" \
    --shell /bin/zsh \
    "{{ username }}"

arch-chroot /mnt chpasswd <<'PHS_PASSWORD_EOF'
{{ username }}:{{ user_password }}
PHS_PASSWORD_EOF

# Sudo
echo "==> configuring sudo"

printf '%s\n' \
    '{{ username }} ALL=(ALL:ALL) NOPASSWD:ALL' \
    > "/mnt/etc/sudoers.d/{{ username }}"

chmod 440 "/mnt/etc/sudoers.d/{{ username }}"

arch-chroot /mnt visudo --check

# Hostname
echo "==> configuring hostname"

printf '%s\n' \
    "{{ hostname }}" \
    > /mnt/etc/hostname

# SSH user access
echo "==> configuring SSH access"

arch-chroot /mnt install \
    -d \
    -m 700 \
    -o "{{ username }}" \
    -g "{{ groupname }}" \
    "/home/{{ username }}/.ssh"

arch-chroot /mnt install \
    -m 600 \
    -o "{{ username }}" \
    -g "{{ groupname }}" \
    /dev/stdin \
    "/home/{{ username }}/.ssh/authorized_keys" <<'PHS_SSH_EOF'
{{ host_pubkey }}
PHS_SSH_EOF


# arch-chroot /mnt sudo -u "{{ username }}" -H bash -lc '
#     mkdir -p ~/projects
#     git clone https://github.com/kolibri/phs.git ~/projects/phs
#     cd ~/projects/phs
#     uv tool install --editable .
# '

# arch-chroot /mnt install \
#     -m 600 \
#     -o "{{ username }}" \
#     -g "{{ groupname }}" \
#     /dev/stdin \
#     "/home/{{ username }}/.phs.yaml" <<'PHS_CONFIG_EOF'
# my_hostname: {{ hostname }}
# PHS_CONFIG_EOF


# Finish
echo "==> syncing filesystems"
sync

echo "==> unmounting installation"
umount -R /mnt

echo
echo "Arch Linux installation complete."
echo "The machine can now be powered off and booted from {{ hdd }}."